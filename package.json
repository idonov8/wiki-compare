{
  "name": "wiki-compare",
  "version": "1.0.0",
  "description": "Compares the English, Hebrew and Arabic Wikipedia articles on one subject and marks where they disagree.",
  "repository": "github:idonov8/wiki-compare",
  "homepage": "https://wikicompare.app",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:init": "node --env-file-if-exists=.env.local scripts/init-db.mjs",
    "fixtures:save": "tsx --env-file-if-exists=.env.local scripts/save-fixture.mts",
    "fixtures:refresh": "tsx --env-file-if-exists=.env.local scripts/save-fixture.mts",
    "check:parser": "tsx scripts/check-parser.mts",
    "check:deterministic": "tsx scripts/check-deterministic.mts",
    "check:sources": "tsx scripts/check-sources.mts",
    "check:input": "tsx scripts/check-input.mts",
    "check:live": "tsx scripts/check-live.mts",
    "check:segment": "tsx scripts/check-segment.mts",
    "check:jev": "tsx scripts/check-jev.mts",
    "check": "npm run check:input && npm run check:parser && npm run check:sources && npm run check:deterministic && npm run check:live && npm run check:segment && npm run check:jev",
    "jev:run": "tsx --env-file-if-exists=.env.local scripts/jev-run.mts",
    "check:ui": "tsx scripts/check-ui.mts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@neondatabase/serverless": "^1.1.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "@vercel/analytics": "^2.0.1",
    "next": "^16.3.0",
    "node-html-parser": "^9.0.1",
    "posthog-js": "^1.413.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  },
  "private": true
}
