# Neon — copy the pooled connection string from the Neon dashboard
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Anthropic API key. Set this in the Vercel dashboard, never commit it.
ANTHROPIC_API_KEY="sk-ant-..."

# Optional overrides
ALIGN_MODEL="claude-haiku-4-5-20251001"
DIFF_MODEL="claude-sonnet-4-6"

# Contact info embedded in the User-Agent we send to Wikipedia. Wikimedia's
# rate limits drop to 10 req/min for clients they can't identify, so this must
# stay a real URL or email that reaches a maintainer.
WIKI_CONTACT="https://wiki-compare.vercel.app; contact@wikicompare.app"

# Signs session cookies and magic-link tokens. Generate with `openssl rand -base64 32`.
# Changing it signs everyone out; sharing it between environments lets a preview
# deployment's cookie authenticate against production.
BETTER_AUTH_SECRET="..."

# The origin Better Auth builds magic-link URLs against, so it must be the URL
# people actually open — a wrong value still sends mail, it just sends a link
# that lands somewhere with no session to hand back.
BETTER_AUTH_URL="http://localhost:3000"

# Resend, for delivering login links. Optional everywhere except a real
# production deployment: with no key set, the link is printed to the server
# console instead, which is the whole local sign-in flow. Production throws
# rather than let a login email silently go nowhere.
#
# "Production" here means VERCEL_ENV, which Vercel sets itself — not NODE_ENV,
# which preview deployments also set to "production" because they are built the
# same way. Previews therefore print the link to the build log like development
# does, which is what you want from an environment nobody configures mail for.
RESEND_API_KEY="re_..."

# Google sign-in, offered alongside the email link. Both halves are required:
# lib/auth.ts registers the provider only when it has the pair, because a
# provider holding an undefined client id does not fail at startup — it fails at
# the end of a redirect, on Google's error page, which is a long way to travel to
# find out a variable was never set.
#
# To create them: Google Cloud Console → APIs & Services → Credentials → Create
# OAuth client ID → Web application. The authorised redirect URI must be exactly
# <origin>/api/auth/callback/google — http://localhost:3000/api/auth/callback/google
# locally, and the same path on every deployed origin you want to sign in from.
# Preview deployments get a new hostname per branch, so either add the ones you
# use or accept that previews sign in by email link only.
GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."

# Whether the browser offers the Google button. The two variables above are
# secrets and cannot be read from a client component, so this is how the sign-in
# screen learns the provider exists; leave it unset and the screen shows the
# email field alone. Set it to "true" only alongside the pair above — lib/auth.ts
# compares the two at startup and warns when they disagree, because the failure
# is otherwise silent in both directions: a button that leads nowhere, or a
# configured provider nobody is ever offered.
NEXT_PUBLIC_GOOGLE_ENABLED="true"

# PostHog. Optional everywhere: with no key set, lib/analytics.ts is a no-op on
# both sides of the wire and the site behaves identically.
#
# Two things have to be true in the PostHog project itself, and neither is
# visible from this repo:
#
#   1. Cookieless mode must be enabled in the project settings. lib/analytics.ts
#      initialises with `cookieless_mode: "always"`, and PostHog drops every
#      cookieless event of a project that has not opted in. The symptom is an
#      empty dashboard, not an error.
#   2. "Discard client IP data" must be on. The client no longer stores an
#      identifier, but ingestion still reads the source IP off the request, and
#      that is the one piece of personal data left in the pipeline.
#
# Prefer an EU project (https://eu.i.posthog.com) over the US default. Israel
# holds an EU adequacy decision, so EU-hosted processing is the shorter
# paragraph in the privacy notice; a US project means disclosing a transfer to a
# jurisdiction with no reciprocal finding.
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
